# Backups hold private data: never commit them
*.json
webkit/
webkit-report.txt
# ...except the Claude Code mods' own manifests (no private data)
!.claude/skills/*/.claude-plugin/plugin.json
!.claude/skills/*/hooks/hooks.json
# ...and the shared mods (mods/, installable anywhere from .claude-plugin/marketplace.json)
!.claude-plugin/marketplace.json
!.claude/settings.json
!mods/*/.claude-plugin/plugin.json
!mods/*/hooks/hooks.json

# where.mjs cache
tools/.cache/

# helper agents' temporary working copies (git worktrees)
.claude/worktrees/

# test tools installed with npm i --no-save (ESLint, Playwright): never committed
node_modules/
